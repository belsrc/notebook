      "fontSize": 20,
      "fontFamily": 3,
      "text": "int sum_rows(int arr[4][4]) {\n int A, B, sum = 0;\n\n for (B = 0; B < 4; B++)\n    for (A = 0; A < 4; A++)\n     sum += arr[A][B];\n\n return sum;\n}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int sum_rows(int arr[4][4]) {\n int A, B, sum = 0;\n\n for (B = 0; B < 4; B++)\n    for (A = 0; A < 4; A++)\n     sum += arr[A][B];\n\n return sum;\n}",
      "autoResize": true,
      "lineHeight": 1.2
